# Server-only configuration. Copy to Backend/.env locally; never commit real credentials.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CORS_ORIGIN=http://localhost:5173

# Vision provider: gemini (free tier for limited testing) or claude (paid API).
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional Claude provider (paid Anthropic API):
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
