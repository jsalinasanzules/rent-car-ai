# Server-only configuration. Copy to Backend/.env locally; never commit real credentials.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
CORS_ORIGIN=http://localhost:5173

# Required only when TASK-004 (Claude Vision) is implemented:
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
CLAUDE_MODEL=replace-with-supported-claude-model-id
